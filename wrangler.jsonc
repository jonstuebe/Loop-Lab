{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loop-lab",
  "compatibility_date": "2026-11-03",
  "observability": {
    "enabled": true
  },
  // Static-only Worker: serves the Vite build output, no Worker script.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
